<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_total"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/azul_oscuro"
            app:titleTextColor="@android:color/white"
            app:title="Reservar pista"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#F0F9FF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvInstalacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pista A · PÁDEL"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/azul_oscuro" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona fecha y horas disponibles"
                        android:textSize="13sp"
                        android:textColor="@color/gris_texto"
                        android:layout_marginTop="2dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅  Fecha de reserva"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/azul_oscuro"
                        android:layout_marginBottom="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSeleccionarFecha"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Seleccionar fecha"
                        android:textColor="@android:color/white"
                        app:backgroundTint="@color/azul_medio"
                        app:cornerRadius="12dp"
                        app:icon="@android:drawable/ic_menu_today"
                        app:iconTint="@android:color/white" />

                    <TextView
                        android:id="@+id/tvFechaSeleccionada"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="15sp"
                        android:textColor="@color/verde_principal"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center_horizontal" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/hora_libre"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Libre"
                        android:textSize="12sp"
                        android:textColor="@color/gris_texto" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/hora_seleccionada"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Seleccionada"
                        android:textSize="12sp"
                        android:textColor="@color/gris_texto" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@color/hora_ocupada"
                        android:layout_marginEnd="6dp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ocupada"
                        android:textSize="12sp"
                        android:textColor="@color/gris_texto" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🕒  Horas disponibles"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/azul_oscuro"
                        android:layout_marginBottom="12dp" />

                    <GridLayout
                        android:id="@+id/gridHorarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:useDefaultMargins="false" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#E8F5E9">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selecciona las horas que quieres reservar"
                        android:textSize="14sp"
                        android:textColor="@color/azul_oscuro"
                        android:gravity="center"
                        android:layout_marginBottom="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReservar"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="CONFIRMAR RESERVA"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:enabled="false"
                        app:backgroundTint="@color/verde_principal"
                        app:cornerRadius="14dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>